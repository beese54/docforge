index 0000000..8b7cafd
--- /dev/null
+++ b/documentation/templates/manual-header.tex
@@ -0,0 +1,19 @@
+% Header/footer for the docforge manual. @@TOKENS@@ are filled in by `docforge build`.
+\usepackage{fancyhdr}
+\usepackage{lastpage}
+\pagestyle{fancy}
+\fancyhf{}
+\fancyhead[L]{\small @@TITLE@@}
+\fancyhead[R]{\small\nouppercase{\leftmark}}
+\fancyfoot[L]{\small Version @@VERSION@@ \textbullet{} @@DATE@@ \textbullet{} @@SHA@@}
+\fancyfoot[R]{\small Page \thepage{} of \pageref*{LastPage}}
+\renewcommand{\headrulewidth}{0.4pt}
+\renewcommand{\footrulewidth}{0.4pt}
+\fancypagestyle{plain}{%
+  \fancyhf{}%
+  \fancyfoot[L]{\small Version @@VERSION@@ \textbullet{} @@DATE@@ \textbullet{} @@SHA@@}%
+  \fancyfoot[R]{\small Page \thepage{} of \pageref*{LastPage}}%
+  \renewcommand{\headrulewidth}{0pt}%
+}
+\usepackage{float}
+\floatplacement{figure}{H}
